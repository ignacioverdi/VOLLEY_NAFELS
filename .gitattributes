# ─────────────────────────────────────────────────────────────────────
#  Fin de línea. Esto apaga los warnings de "LF will be replaced by
#  CRLF" y, más importante, evita que archivos sin ningún cambio real
#  figuren como modificados en cada commit.
# ─────────────────────────────────────────────────────────────────────

* text=auto eol=lf

# ══ EXCEPCIÓN IMPORTANTE ═════════════════════════════════════════════
# Los .bat y los .ps1 de Windows tienen que llevar finales CRLF. Con LF
# un .bat puede fallar de formas raras (sobre todo con goto y labels),
# y vos corrés TODO desde .bat.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# ══ BINARIOS: que Git ni los mire ═══════════════════════════════════
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.mov  binary
*.mp3  binary
*.wav  binary
*.m4a  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.xlsx binary
*.pptx binary
*.zip  binary
*.enc  binary

# Los .dvw son texto pero con codificación propia: que los deje en paz
*.dvw -text
